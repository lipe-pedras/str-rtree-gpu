# ── Compiled binaries ──────────────────────────────────────
bin/*
!bin/.gitkeep

# ── Dataset files ──────────────────────────────────────────
data/*
!data/.gitkeep

# ── Intermediate sort/tmp files ────────────────────────────
tmp/*
!tmp/.gitkeep

# ── Old build artifacts (legacy, when building inside src/) ─
src/*.o
src/external_str
src/gen_points
src/gpu_info
*.bin
*.tmp

# ── Animation output (rendered video + generated dataset) ──
animation/media/
animation/data/

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/

# ── IDE ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ───────────────────────────────────────────────────
*.log
